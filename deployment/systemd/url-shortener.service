[Unit]
Description=AWS URL Shortener FastAPI Backend Service
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/examne2/backend
Environment="PATH=/home/ubuntu/examne2/backend/venv/bin"
EnvironmentFile=/home/ubuntu/examne2/backend/.env
ExecStart=/home/ubuntu/examne2/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2

# Automatic restart on failure
Restart=always
RestartSec=5s

# Standard output and error logging to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=url-shortener

[Install]
WantedBy=multi-user.target
