# AWS Configuration
AWS_REGION=us-east-1
DYNAMODB_TABLE=url_shortener

# Base URL used to construct the short_url returned in responses
# In EC2, set this to: http://<EC2_PUBLIC_IP>:8000 or your custom domain
BASE_URL=http://localhost:8000

# Server settings
HOST=0.0.0.0
PORT=8000

# CORS settings: comma-separated origins (e.g. http://my-s3-bucket.s3-website-us-east-1.amazonaws.com,http://localhost:3000)
# Use * during initial testing, or specify your exact S3 website URL
CORS_ORIGINS=*

# Development mode: set to true to test locally in-memory without AWS credentials
USE_MOCK_DB=false
